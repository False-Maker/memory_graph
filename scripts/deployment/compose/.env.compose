COMPOSE_PROJECT_NAME=memory-graph

# Published ports on the host.
COMPOSE_API_PUBLISHED_PORT=8000
COMPOSE_MCP_PUBLISHED_PORT=8001

# Whether Docker images should include the local sentence-transformers stack.
COMPOSE_INCLUDE_LOCAL_EMBEDDING=false

# MCP HTTP surface.
MEMORY_GRAPH_MCP_MOUNT_PATH=/
MEMORY_GRAPH_MCP_STREAMABLE_HTTP_PATH=/mcp
MEMORY_GRAPH_MCP_STATELESS_HTTP=true

# Optional bearer auth for MCP.
# MEMORY_GRAPH_MCP_BEARER_TOKEN=change-me
