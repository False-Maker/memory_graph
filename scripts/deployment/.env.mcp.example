# Optional MCP-only override profile.
# Copy to .env.mcp when you want MCP transport settings separated from .env.intranet.

MEMORY_GRAPH_MCP_HOST=127.0.0.1
MEMORY_GRAPH_MCP_PORT=8001
MEMORY_GRAPH_MCP_MOUNT_PATH=/
MEMORY_GRAPH_MCP_STREAMABLE_HTTP_PATH=/mcp
MEMORY_GRAPH_MCP_STATELESS_HTTP=true
# MEMORY_GRAPH_MCP_BEARER_TOKEN=change-me

# Optional Python override
PYTHON_BIN=python3

# Optional extra PYTHONPATH when the MCP SDK is outside the active environment
# MCP_PYTHONPATH=/opt/mcp-sdk
