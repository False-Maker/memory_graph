#!/usr/bin/env bash
# Intranet single-node profile example for Task 15
# Copy to .env.intranet and edit values as needed.

# Required by scripts/deployment/check-required-env.sh
OPENAI_API_KEY=dummy-key
# ANTHROPIC_API_KEY=

# Legacy-only: keep commented unless you explicitly wire a non-default Neo4j path.
# NEO4J_URI=bolt://127.0.0.1:7687
# NEO4J_PASSWORD=change-me

# Optional ports
PY_API_PORT=8000
SIDECAR_PORT=3001

# Optional MCP streamable-http deployment settings
MEMORY_GRAPH_MCP_HOST=127.0.0.1
MEMORY_GRAPH_MCP_PORT=8001
MEMORY_GRAPH_MCP_MOUNT_PATH=/
MEMORY_GRAPH_MCP_STREAMABLE_HTTP_PATH=/mcp
MEMORY_GRAPH_MCP_STATELESS_HTTP=true
# MEMORY_GRAPH_MCP_BEARER_TOKEN=change-me

# Optional log level
LOG_LEVEL=INFO

# Optional Python executable override
PYTHON_BIN=python3
