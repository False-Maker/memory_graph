FROM node:22-bookworm-slim AS build
WORKDIR /app/frontend/api
COPY frontend/api/package.json frontend/api/package-lock.json ./
RUN npm ci
COPY frontend/api/. ./
RUN npm run build && npm prune --omit=dev

FROM node:22-bookworm-slim AS runner
WORKDIR /app/frontend/api
ENV NODE_ENV=production
COPY --from=build /app/frontend/api/package.json ./package.json
COPY --from=build /app/frontend/api/package-lock.json ./package-lock.json
COPY --from=build /app/frontend/api/node_modules ./node_modules
COPY --from=build /app/frontend/api/dist ./dist
EXPOSE 3001
CMD ["node", "dist/main.js"]
