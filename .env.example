# Memory Graph - 环境变量示例
# 复制此文件为 .env 并填入你的配置

# ============================================
# LLM API 密钥 (必填至少一个)
# ============================================
# OpenAI API Key
OPENAI_API_KEY=

# Anthropic (Claude) API Key
ANTHROPIC_API_KEY=

# Memory Graph API Bearer token. Required by default.
MEMORY_GRAPH_API_TOKEN=

# ============================================
# 可选数据库凭证
# ============================================
# PostgreSQL 密码 (如使用 pgvector)
PGPASSWORD=your-postgres-password

# ============================================
# 可选配置
# ============================================
# 日志级别: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Sidecar upstream used by FastAPI when serving the built React Web app
SIDECAR_BASE_URL=http://127.0.0.1:3001

# Optional frontend runtime overrides (only VITE_* will be exposed to the browser)
# VITE_API_BASE_URL=/api/v1
# VITE_BACKEND_HEALTH_URL=/health
# VITE_SIDECAR_HEALTH_URL=/sidecar/health
# VITE_MEMORY_GRAPH_API_TOKEN=

# 数据目录 (可选)
# DATA_DIR=./data
