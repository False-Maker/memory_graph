# Cloud deployment environment template (T16)
# Security baseline (no-login stage): private network only + allowlist required.

# Required secrets
OPENAI_API_KEY=replace_me
# ANTHROPIC_API_KEY=replace_me

# Legacy-only: keep commented unless you explicitly wire a non-default Neo4j path.
# NEO4J_URI=bolt://127.0.0.1:7687
# NEO4J_PASSWORD=replace_me

# Required cloud safety gates
PRIVATE_NETWORK_ONLY=true
ALLOWLIST_CIDRS=10.0.0.0/16,192.168.0.0/16

# Optional service ports (must remain compatible with baseline defaults)
PY_API_PORT=8000
SIDECAR_PORT=3001

# Optional runtime settings
LOG_LEVEL=INFO
PYTHON_BIN=python3
